# Copy to .env for local development. In production, set these in your host's
# dashboard instead; never commit a real .env.

# --- Server -------------------------------------------------------------------
# "production" switches on the safe defaults marked [prod] below
NODE_ENV=development
# Port to listen on. Hosts usually set PORT; API_PORT wins when both are set.
API_PORT=4000
# Database: a local SQLite file path (its folder is created if missing), or a hosted
# Turso URL such as libsql://leadhub-<org>.turso.io. DB_PATH is accepted as an older name.
DATABASE_URL=data/crm.db
# Turso access token (only for libsql:// URLs)
DATABASE_AUTH_TOKEN=
# HTTPS-only session cookies + HSTS. [prod] defaults to true
COOKIE_SECURE=false
# Proxies in front of the app whose X-Forwarded-For is trusted: a hop count (1 for
# most hosts), true/false, or addresses. Default: loopback only.
TRUST_PROXY=
# One JSON log line per request. [prod] defaults to true
LOG_REQUESTS=

# --- Backups ------------------------------------------------------------------
# Snapshot interval in hours, 0 = off. [prod] defaults to 24
BACKUP_INTERVAL_HOURS=
# Folder for snapshots (default: "backups" next to the database) and how many to keep
BACKUP_DIR=
BACKUP_KEEP=7

# --- First run ------------------------------------------------------------------
# Only used while the database has no users.
SEED_ADMIN_EMAIL=admin@yourcompany.com
# At least 12 characters. Required in production; in development an empty value
# prints a random password in the server log.
SEED_ADMIN_PASSWORD=
# Password for the fictional demo sales reps (only when SEED_DEMO=true)
SEED_REP_PASSWORD=
# Load fictional demo data on first run. [prod] defaults to false
SEED_DEMO=true

# --- AI (optional) --------------------------------------------------------------
# Claude API key. Server-side only; never exposed to the browser.
# While empty, AI features show "Not configured".
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
