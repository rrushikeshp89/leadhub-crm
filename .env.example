# Copy to .env for local development. In production, set these in your host's
# dashboard instead; never commit a real .env.

# --- Server -------------------------------------------------------------------
# Port the API (and, after `npm run build`, the web app) listens on
API_PORT=4000
# SQLite database file; its folder is created if missing. Must be on a persistent disk.
DB_PATH=data/crm.db
# Set to true whenever the app is served over HTTPS
COOKIE_SECURE=false

# --- First run ------------------------------------------------------------------
# Only used while the database has no users.
SEED_ADMIN_EMAIL=admin@yourcompany.com
# Leave empty to have a random password printed in the server log on first run
SEED_ADMIN_PASSWORD=
# Password for the fictional demo sales reps (only when SEED_DEMO=true)
SEED_REP_PASSWORD=
# Load fictional demo data on first run (true/false)
SEED_DEMO=true

# --- AI (optional) --------------------------------------------------------------
# Claude API key. Server-side only; never exposed to the browser.
# While empty, AI features show "Not configured".
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
